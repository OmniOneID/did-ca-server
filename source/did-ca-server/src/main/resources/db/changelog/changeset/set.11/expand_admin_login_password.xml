<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">
    <changeSet id="add-admin-password-algo-for-bcrypt" author="opendid">
        <addColumn tableName="admin">
            <column name="password_algo" type="VARCHAR(20)" defaultValue="sha256">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
    <changeSet id="expand-admin-login-password-for-bcrypt" author="opendid">
        <modifyDataType tableName="admin" columnName="login_password" newDataType="VARCHAR(120)"/>
    </changeSet>
</databaseChangeLog>
